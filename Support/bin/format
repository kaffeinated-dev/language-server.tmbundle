#!/bin/bash
# Formats the document with its language server, for commands of other
# bundles (require this bundle to get TM_LANGUAGE_SERVER_BUNDLE_SUPPORT): the
# server’s edits are applied to the document, in place, so they can be undone.
# Exits 0 when the document changed, 1 when there was nothing to change, and 2
# when the document has no language server, or one that does not format
# documents (or is starting); with another status when it could not be
# formatted. The reason is on standard error.
. "$(dirname "${BASH_SOURCE[0]}")/../lib/language_server.sh"
language_server_format
